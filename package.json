{
  "name": "itcom-qa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --workspace apps/web run dev",
    "ai:dev": "npm --workspace apps/ai-service run dev",
    "web:build": "npm --workspace apps/web run build",
    "ai:build": "npm --workspace apps/ai-service run build",
    "build": "npm run web:build && npm run ai:build",
    "lint:js": "npm --workspace apps/web run lint:js",
    "lint:css": "npm --workspace apps/web run lint:css",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "npm --workspace apps/web run format",
    "validate": "npm run lint && npm run format",
    "bootstrap": "npm install",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "prisma": "^6.11.1",
    "stylelint": "^16.21.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-tailwindcss": "^1.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1"
  }
}
