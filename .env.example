# All env variables

# ======================
# 🚀 DATABASE CONFIG
# ======================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ======================
# 🔐 AUTHENTICATION (NextAuth.js / Auth.js)
# ======================
AUTH_SECRET=your-random-secret

# GitHub OAuth (https://docs.github.com/en/apps/oauth-apps)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ======================
# 🔍 MEILISEARCH CONFIG
# ======================
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=your-meili-api-key

# ======================
# 🌐 DEPLOYMENT
# ======================
# Used by Vercel or other hosting platforms
NEXT_PUBLIC_VERCEL_URL=https://your-site.vercel.app

# ======================
# 🤖 AI MICROSERVICE (Optional)
# ======================
AI_API_URL=http://localhost:8000/api
AI_API_KEY=your-fastapi-secret

# ======================
# 📊 ANALYTICS
# ======================
# Google Analytics 4 ID
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ======================
# 🌍 GENERAL SITE METADATA
# ======================
NEXT_PUBLIC_SITE_NAME=Your Q&A Platform
NEXT_PUBLIC_SITE_DESCRIPTION=Ask questions. Get answers. Share knowledge.
